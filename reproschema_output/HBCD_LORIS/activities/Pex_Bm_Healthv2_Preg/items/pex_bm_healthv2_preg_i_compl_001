  "category": "reproschema:Item",
  "id": "pex_bm_healthv2_preg_i_compl_001",
  "prefLabel": {
    "en": "pex_bm_healthv2_preg_i_compl_001"
  },
  "question": {
    "en": "During your pregnancy, were you ever told that you have any of the following?"
  },
  "ui": {
    "inputType": "selectMultiple"
  },
  "responseOptions": {
    "valueType": [
      "xsd:string"
    ],
    "multipleChoice": true,
    "choices": [
      {
        "name": {
          "en": "1"
        },
        "value": "Gestational diabetes (diabetes that started during the pregnancy)"
      },
      {
        "name": {
          "en": "2"
        },
        "value": "High blood pressure (hypertension) that was first diagnosed during the pregnancy"
      },
      {
        "name": {
          "en": "3"
        },
        "value": "Pre-eclampsia or eclampsia (high blood pressure related to pregnancy)"
      },
      {
        "name": {
          "en": "4"
        },
        "value": "Pulmonary embolism (blood clot to the lungs)"
      },
      {
        "name": {
          "en": "5"
        },
        "value": "Deep vein thrombosis (blood clot in the legs or other vein)"
      },
      {
        "name": {
          "en": "6"
        },
        "value": "Cervical insufficiency or cervical incompetence"
      },
      {
        "name": {
          "en": "7"
        },
        "value": "Chorioamnionitis or infection in the womb during labor"
      },
      {
        "name": {
          "en": "8"
        },
        "value": "Placenta previa (placenta blocking the cervix)"
      },
      {
        "name": {
          "en": "9"
        },
        "value": "Oligohydramnios (not enough amniotic fluid)"
      },
      {
        "name": {
          "en": "10"
        },
        "value": "Polyhydramnios (too much amniotic fluid)"
      },
      {
        "name": {
          "en": "11"
        },
        "value": "Fetal growth restriction or poor growth of the baby"
      },
      {
        "name": {
          "en": "12"
        },
        "value": "None of these"
      },
      {
        "name": {
          "en": "999"
        },
        "value": "Don't know"
      },
      {
        "name": {
          "en": "777"
        },
        "value": "Decline to answer"
      }
    ]
  },
