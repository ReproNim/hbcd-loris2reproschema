  "question": {
    "en": "In a typical week, does anyone else, besides you, take care of your child on a regular basis? By regular, we mean at least once a week for the past month. Do not include occasional babysitting. (Select all that apply, and then indicate how often as items appear below.)"
  },
  "ui": {
    "inputType": "selectMultiple"
  },
  "responseOptions": {
    "valueType": [
      "xsd:string"
    ],
    "multipleChoice": true,
    "choices": [
      {
        "name": {
          "en": "1"
        },
        "value": "Cared for by another caregiver, such as the child's father, other primary caregiver, or your current spouse or partner"
      },
      {
        "name": {
          "en": "2"
        },
        "value": "Cared for by another family member, such as a grandparent, aunt, or sibling"
      },
      {
        "name": {
          "en": "3"
        },
        "value": "Cared for by someone outside the family"
      },
      {
        "name": {
          "en": "555"
        },
        "value": "Not applicable - No one else but me takes care of the child"
      },
      {
        "name": {
          "en": "999"
        },
        "value": "Don't know"
      },
      {
        "name": {
          "en": "777"
        },
        "value": "Decline to answer"
      }
    ]
  },
