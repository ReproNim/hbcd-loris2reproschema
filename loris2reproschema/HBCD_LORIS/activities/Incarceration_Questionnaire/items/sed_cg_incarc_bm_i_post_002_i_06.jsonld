  "id": "sed_cg_incarc_bm_i_post_002_i_06",
  "prefLabel": {
    "en": "sed_cg_incarc_bm_i_post_002_i_06"
  },
  "question": {
    "en": "For the child's biological mother/birthing parent's LONGEST incarceration since this child was born, how long did it last?"
  },
  "ui": {
    "inputType": "select"
  },
  "responseOptions": {
    "valueType": [
      "xsd:string"
    ],
    "choices": [
      {
        "name": {
          "en": "1"
        },
        "value": "1 day (overnight)"
      },
      {
        "name": {
          "en": "2"
        },
        "value": "2 days to less than 1 month"
      },
      {
        "name": {
          "en": "3"
        },
        "value": "1 month to less than 6 months"
      },
      {
        "name": {
          "en": "4"
        },
        "value": "6 months to less than one year"
      },
      {
        "name": {
          "en": "5"
        },
        "value": "1 year or more"
      },
      {
        "name": {
          "en": "999"
        },
        "value": "Don't know"
      },
      {
        "name": {
          "en": "777"
        },
        "value": "Decline to answer"
      }
    ]
  },
  "preamble": {
    "en": "Conditional display: sed_cg_incarc_bm_i_post_002_i_01 == '1'"
  },
