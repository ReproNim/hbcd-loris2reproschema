  "category": "reproschema:Item",
  "id": "repetition_time",
  "prefLabel": {
    "en": "repetition_time"
  },
  "question": {
    "en": "The period of time in msec between the beginning of a pulse sequence and the beginning of the succeeding (essentially identical) pulse sequence. Required except when Scanning Sequence (0018,0020) is EP and Sequence Variant (0018,0021) is not SK."
  },
