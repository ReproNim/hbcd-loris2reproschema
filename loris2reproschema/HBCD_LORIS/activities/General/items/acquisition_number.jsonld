  "category": "reproschema:Item",
  "id": "acquisition_number",
  "prefLabel": {
    "en": "acquisition_number"
  },
  "question": {
    "en": "A number identifying the single continuous gathering of data over a period of time that resulted in this image or instance, which may include multiple bed positions. This number is not required to be unique across SOP Instances in a series. DICOM:0020_0012"
  },
