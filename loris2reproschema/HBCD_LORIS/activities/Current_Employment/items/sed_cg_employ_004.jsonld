  "category": "reproschema:Item",
  "id": "sed_cg_employ_004",
  "prefLabel": {
    "en": "sed_cg_employ_004"
  },
  "question": {
    "en": "During the past 12 months in the weeks in which you worked, how many hours per week did you typically work in ALL jobs?"
  },
  "ui": {
    "inputType": "select"
  },
  "responseOptions": {
    "valueType": [
      "xsd:string"
    ],
    "choices": [
      {
        "name": {
          "en": "1"
        },
        "value": "Less than 5 hours"
      },
      {
        "name": {
          "en": "2"
        },
        "value": "5-10 hours"
      },
      {
        "name": {
          "en": "3"
        },
        "value": "11-20 hours"
      },
      {
        "name": {
          "en": "4"
        },
        "value": "21-30 hours"
      },
      {
        "name": {
          "en": "5"
        },
        "value": "31-40 hours"
      },
      {
        "name": {
          "en": "6"
        },
        "value": "More than 40 hours"
      },
      {
        "name": {
          "en": "999"
        },
        "value": "Don't know"
      },
      {
        "name": {
          "en": "777"
        },
        "value": "Decline to answer"
      }
    ]
  },
  "preamble": {
    "en": "Conditional display: (sed_cg_employ_003 == '1' OR sed_cg_employ_003 == '2' OR sed_cg_employ_003 == '3' OR sed_cg_employ_003 == '4' OR sed_cg_employ_003 == '5' OR sed_cg_employ_003 == '6' OR sed_cg_employ_003 == '7') AND sed_cg_employ_003 !== 777 AND sed_cg_employ_003 !== '999'"
  },
