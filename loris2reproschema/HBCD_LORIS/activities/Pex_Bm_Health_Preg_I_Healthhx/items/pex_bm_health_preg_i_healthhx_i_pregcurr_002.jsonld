  "id": "pex_bm_health_preg_i_healthhx_i_pregcurr_002",
  "prefLabel": {
    "en": "pex_bm_health_preg_i_healthhx_i_pregcurr_002"
  },
  "question": {
    "en": "Which of the following statements best describes you during the three months before you got pregnant?"
  },
  "ui": {
    "inputType": "select"
  },
  "responseOptions": {
    "valueType": [
      "xsd:string"
    ],
    "choices": [
      {
        "name": {
          "en": "1"
        },
        "value": "I was trying to get pregnant"
      },
      {
        "name": {
          "en": "2"
        },
        "value": "I was not trying to get pregnant but I also was not trying to keep from getting pregnant"
      },
      {
        "name": {
          "en": "3"
        },
        "value": "I was trying to keep from getting pregnant"
      },
      {
        "name": {
          "en": "999"
        },
        "value": "Don't know"
      },
      {
        "name": {
          "en": "777"
        },
        "value": "Decline to answer"
      }
    ]
  },
