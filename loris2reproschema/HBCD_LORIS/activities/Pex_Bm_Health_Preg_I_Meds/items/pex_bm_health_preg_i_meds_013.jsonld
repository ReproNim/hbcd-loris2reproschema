{
  "@context": "https://raw.githubusercontent.com/ReproNim/reproschema/1.0.0/contexts/generic",
  "category": "reproschema:Item",
  "id": "pex_bm_health_preg_i_meds_013",
  "prefLabel": {
    "en": "pex_bm_health_preg_i_meds_013"
  },
  "question": {
    "en": "Many individuals use a common over-the-counter medication at some point during pregnancy. Examples include  antacids (tums, maalox), allergy medications (Claritin), cold, sinus or flu (Mucinex, Sinex), cough medicines (Robitussin), anti-diarrhea (Imodium), laxatives (Metamucil), stool softener (Colace), gas relief (gas-X), anti-nausea (Dramamine), sleep agents (Tylenol PM), and pain medications (Advil, Aleve). Are there any over-the-counter medications that you have taken since your last menstrual period?"
  },
  "ui": {
    "inputType": "select"
  },
  "responseOptions": {
    "valueType": [
      "xsd:string"
    ],
    "choices": [
      {
        "name": {
          "en": "1"
        },
        "value": "Yes"
      },
      {
        "name": {
          "en": "0"
        },
        "value": "No"
      },
      {
        "name": {
          "en": "999"
        },
        "value": "Don't know"
      },
      {
        "name": {
          "en": "777"
        },
        "value": "Decline to answer"
      }
    ]
  },
