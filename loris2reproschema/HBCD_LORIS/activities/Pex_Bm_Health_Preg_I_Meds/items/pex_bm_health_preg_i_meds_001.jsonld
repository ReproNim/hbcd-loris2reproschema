{
  "@context": "https://raw.githubusercontent.com/ReproNim/reproschema/1.0.0/contexts/generic",
  "category": "reproschema:Item",
  "id": "pex_bm_health_preg_i_meds_001",
  "prefLabel": {
    "en": "pex_bm_health_preg_i_meds_001"
  },
  "question": {
    "en": "Many individuals use a prescription medication at some point during pregnancy, including pain medications (codeine, hydrocodone), antidepressants (Celexa, Prozac), Sedatives (Xanax, Valium), Insulin, antibiotics (penicillin, Cipro), anti-fungal (miconazole), anti-nausea (zofran), anti-seizure (gabapentin, lamictal), antipsychotics (Zyprexa, Risperidone), mood stabilizers (lithium), stimulants (Adderall, Concerta), blood pressure medications (Vasotrec, Zestril), or sleeping agents (Ambien, Halcion). Are there any prescription medications that you have taken since your last menstrual period?"
  },
  "ui": {
    "inputType": "select"
  },
  "responseOptions": {
    "valueType": [
      "xsd:string"
    ],
    "choices": [
      {
        "name": {
          "en": "1"
        },
        "value": "Yes"
      },
      {
        "name": {
          "en": "0"
        },
        "value": "No"
      },
      {
        "name": {
          "en": "999"
        },
        "value": "Don't know"
      },
      {
        "name": {
          "en": "777"
        },
        "value": "Decline to answer"
      }
    ]
  },
