  "id": "mh_cg_quic_instr01",
  "prefLabel": {
    "en": "mh_cg_quic_instr01"
  },
  "question": {
    "en": "This set of questions asks about your child's experiences. When we say parents, we mean you and whoever else in your child's life fills that role for your child (for example, biological parents, stepparents, adoptive parents, romantic or domestic partners, grandparents, foster parents). This could be one person, or this could be multiple people.We are going to ask about your child's experiences from birth to now. Please answer these questions based on your child's typical or average experiences."
  },
  "ui": {
    "inputType": "text"
  },
  "responseOptions": {
    "valueType": [
      "xsd:string"
    ]
  },
