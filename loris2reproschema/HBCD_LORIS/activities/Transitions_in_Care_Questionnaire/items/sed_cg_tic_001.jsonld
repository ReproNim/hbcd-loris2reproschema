{
  "@context": "https://raw.githubusercontent.com/ReproNim/reproschema/1.0.0/contexts/generic",
  "category": "reproschema:Item",
  "id": "sed_cg_tic_001",
  "prefLabel": {
    "en": "sed_cg_tic_001"
  },
  "question": {
    "en": "The next few questions ask about the people who have provided care and support for CHILD at different times during CHILD's life. Since CHILD was born, has there been a time when someone other than you was primarily responsible for providing CHILD with care and support?  [NOTE: This might include times the child was in the care of someone else, or times that you could not care for CHILD for 2 weeks or more, or when things in your life kept you from having time for being CHILD's caregiver. Do NOT include very short periods like a weekend away or a vacation, or periods of time like when you were working -- or had an appointment - so CHILD had daycare, a nanny, or a babysitter."
  },
  "ui": {
    "inputType": "select"
  },
  "responseOptions": {
    "valueType": [
      "xsd:string"
    ],
    "choices": [
      {
        "name": {
          "en": "1"
        },
        "value": "Yes"
      },
      {
        "name": {
          "en": "0"
        },
        "value": "No"
      },
      {
        "name": {
          "en": "999"
        },
        "value": "Don't know"
      },
      {
        "name": {
          "en": "777"
        },
        "value": "Decline to answer"
      }
    ]
  },
