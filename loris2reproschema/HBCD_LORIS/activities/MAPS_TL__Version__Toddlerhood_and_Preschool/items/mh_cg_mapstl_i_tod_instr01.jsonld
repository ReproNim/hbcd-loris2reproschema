  "prefLabel": {
    "en": "mh_cg_mapstl_i_tod_instr01"
  },
  "question": {
    "en": "Now we are interested in learning about your child's behavior and feelings when angry, upset or frustrated. Please answer the following questions about the past month with your child. You may notice that more than one question asks about similar behaviors or feelings. This is because children may express the same thing in different ways. Thank you for responding to each item to provide us with a detailed picture of how your child manages behavior and feelings."
  },
  "ui": {
    "inputType": "text"
  },
  "responseOptions": {
    "valueType": [
      "xsd:string"
    ]
  },
