{
  "@context": "https://raw.githubusercontent.com/ReproNim/reproschema/1.0.0/contexts/generic",
  "category": "reproschema:Item",
  "id": "sed_bm_demo_herit_i_oth_002",
  "prefLabel": {
    "en": "sed_bm_demo_herit_i_oth_002"
  },
  "question": {
    "en": "Which categories describe the other biological parent? Select all that apply. Note, you may select more than one group."
  },
  "ui": {
    "inputType": "selectMultiple"
  },
  "responseOptions": {
    "valueType": [
      "xsd:string"
    ],
    "multipleChoice": true,
    "choices": [
      {
        "name": {
          "en": "0"
        },
        "value": "American Indian or Alaska Native (For example: Aztec, Blackfeet Tribe, Mayan, Navajo Nation, Native Village of Barrow (Utqiagvik) Inupiat Traditional Government, Nome Eskimo Community, etc.)"
      },
      {
        "name": {
          "en": "1"
        },
        "value": "Asian (For example: Asian Indian, Chinese, Filipino, Japanese, Korean, Vietnamese, etc.)"
      },
      {
        "name": {
          "en": "2"
        },
        "value": "Black, African American, or African (For example: African American, Ethiopian, Haitian, Jamaican, Nigerian, Somali, etc.)"
      },
      {
        "name": {
          "en": "3"
        },
        "value": "Hispanic, Latino, or Spanish (For example: Colombian, Cuban, Dominican, Mexican or Mexican American, Puerto Rican, Salvadoran, etc.)"
      },
      {
        "name": {
          "en": "4"
        },
        "value": "Middle Eastern or North African (For example: Algerian, Egyptian, Iranian, Lebanese, Moroccan, Syrian, etc.)"
      },
      {
        "name": {
          "en": "5"
        },
        "value": "Native Hawaiian or other Pacific Islander (For example: Chamorro, Fijian, Marshallese, Native Hawaiian, Tongan, etc.)"
      },
      {
        "name": {
          "en": "6"
        },
        "value": "White (For example: English, European, French, German, Irish, Italian, Polish, etc.)"
      },
      {
        "name": {
          "en": "7"
        },
        "value": "None of these fully describe the other biological parent"
      },
      {
        "name": {
          "en": "999"
        },
        "value": "Don't know"
      },
      {
        "name": {
          "en": "777"
        },
        "value": "Decline to answer"
      }
    ]
  },
  "preamble": {
    "en": "Conditional display: sed_bm_demo_obp_001 == '1'"
  },
