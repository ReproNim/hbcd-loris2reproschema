  "question": {
    "en": "Approximately how many hours per week did you work at your most recent or current job?"
  },
  "ui": {
    "inputType": "select"
  },
  "responseOptions": {
    "valueType": [
      "xsd:string"
    ],
    "choices": [
      {
        "name": {
          "en": "1"
        },
        "value": "20-30 hours"
      },
      {
        "name": {
          "en": "2"
        },
        "value": "31-40 hours"
      },
      {
        "name": {
          "en": "3"
        },
        "value": "More than 40 hours"
      },
      {
        "name": {
          "en": "999"
        },
        "value": "Don't know"
      },
      {
        "name": {
          "en": "777"
        },
        "value": "Decline to answer"
      }
    ]
  },
