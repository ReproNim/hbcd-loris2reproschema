  "id": "sed_bm_demo_sexorient_001",
  "prefLabel": {
    "en": "sed_bm_demo_sexorient_001"
  },
  "question": {
    "en": "Which of the following best represents how you think of yourself?"
  },
  "ui": {
    "inputType": "select"
  },
  "responseOptions": {
    "valueType": [
      "xsd:string"
    ],
    "choices": [
      {
        "name": {
          "en": "1"
        },
        "value": "Gay"
      },
      {
        "name": {
          "en": "2"
        },
        "value": "Lesbian"
      },
      {
        "name": {
          "en": "3"
        },
        "value": "Straight; that is, not gay or lesbian, etc."
      },
      {
        "name": {
          "en": "4"
        },
        "value": "Bisexual"
      },
      {
        "name": {
          "en": "5"
        },
        "value": "None of these describe me, and I'd like to see additional options"
      },
      {
        "name": {
          "en": "999"
        },
        "value": "Don't know"
      },
      {
        "name": {
          "en": "777"
        },
        "value": "Decline to answer"
      }
    ]
  },
  "preamble": {
