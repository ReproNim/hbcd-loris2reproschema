  "prefLabel": {
    "en": "pex_bm_healthv2_preg_i_exp_i_pnv_008"
  },
  "question": {
    "en": "When we last met you stated that you had not used or were no longer using a prenatal vitamin or a folic acid containing vitamin? Following our last visit did you restart or start taking a prenatal vitamin or folic acid containing vitamin?"
  },
  "ui": {
    "inputType": "select"
  },
  "responseOptions": {
    "valueType": [
      "xsd:string"
    ],
    "choices": [
      {
        "name": {
          "en": "0"
        },
        "value": "No, did not take or restart"
      },
      {
        "name": {
          "en": "1"
        },
        "value": "Yes, began taking"
      },
      {
        "name": {
          "en": "999"
        },
        "value": "Don't know"
      },
      {
        "name": {
          "en": "777"
        },
        "value": "Decline to answer"
      }
    ]
  },
  "preamble": {
    "en": "Conditional display: (v01_arm_1pex_bm_health_preg_i_healthhx_i_exp_i_pnv_006 == '0' OR v01_arm_1pex_bm_health_preg_i_healthhx_i_exp_i_pnv_006_i_02 == '1') AND screening_arm_1recruitment_period =='1'"
