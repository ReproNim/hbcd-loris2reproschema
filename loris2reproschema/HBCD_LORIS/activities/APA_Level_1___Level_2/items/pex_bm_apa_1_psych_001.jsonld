  },
  "question": {
    "en": "Hearing things other people couldn't hear, such as voices even when no one was around?"
  },
  "ui": {
    "inputType": "select"
  },
  "responseOptions": {
    "valueType": [
      "xsd:string"
    ],
    "choices": [
      {
        "name": {
          "en": "0"
        },
        "value": "None-Not at all"
      },
      {
        "name": {
          "en": "1"
        },
        "value": "Slight-Rare, less than a day or two"
      },
      {
        "name": {
          "en": "2"
        },
        "value": "Mild-Several Days"
      },
      {
        "name": {
          "en": "3"
        },
        "value": "Moderate-More than half the days"
      },
      {
        "name": {
          "en": "4"
        },
        "value": "Severe-Nearly every day"
      },
      {
        "name": {
          "en": "999"
        },
        "value": "Don't know"
      },
      {
        "name": {
          "en": "777"
        },
        "value": "Decline to answer"
      }
    ]
  },
