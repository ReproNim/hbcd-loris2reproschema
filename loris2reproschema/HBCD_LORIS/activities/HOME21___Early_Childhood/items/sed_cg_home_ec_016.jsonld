{
  "@context": "https://raw.githubusercontent.com/ReproNim/reproschema/1.0.0/contexts/generic",
  "category": "reproschema:Item",
  "id": "sed_cg_home_ec_016",
  "prefLabel": {
    "en": "sed_cg_home_ec_016"
  },
  "question": {
    "en": "Most children get angry at their parents/caregivers from time to time. If your child got so angry that they hit you, what would you do? (check all that apply)"
  },
  "ui": {
    "inputType": "selectMultiple"
  },
  "responseOptions": {
    "valueType": [
      "xsd:string"
    ],
    "multipleChoice": true,
    "choices": [
      {
        "name": {
          "en": "1"
        },
        "value": "Yell at Child"
      },
      {
        "name": {
          "en": "2"
        },
        "value": "Send child to their room"
      },
      {
        "name": {
          "en": "3"
        },
        "value": "Spank child"
      },
      {
        "name": {
          "en": "4"
        },
        "value": "Talk to child"
      },
      {
        "name": {
          "en": "5"
        },
        "value": "Ignore it"
      },
      {
        "name": {
          "en": "6"
        },
        "value": "Give child a household chore"
      },
      {
        "name": {
          "en": "7"
        },
        "value": "Take away allowance"
      },
      {
        "name": {
          "en": "8"
        },
        "value": "Hold child's hand until calm"
      },
      {
        "name": {
          "en": "9"
        },
        "value": "Put child in a short time out"
      },
      {
        "name": {
          "en": "10"
        },
        "value": "Something else"
      },
      {
        "name": {
          "en": "999"
        },
        "value": "Don't know"
      },
      {
        "name": {
          "en": "777"
        },
        "value": "Decline to answer"
      }
    ]
  },
