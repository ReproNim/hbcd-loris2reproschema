{
  "@context": "https://raw.githubusercontent.com/ReproNim/reproschema/1.0.0/contexts/generic",
  "category": "reproschema:Item",
  "id": "pex_bm_healthv2_inf_006",
  "prefLabel": {
    "en": "pex_bm_healthv2_inf_006"
  },
  "question": {
    "en": "Were you told in the hospital that your baby had any of the following? Check all that apply"
  },
  "ui": {
    "inputType": "selectMultiple"
  },
  "responseOptions": {
    "valueType": [
      "xsd:string"
    ],
    "multipleChoice": true,
    "choices": [
      {
        "name": {
          "en": "1"
        },
        "value": "Bronchopulmonary dysplasia (BPD) or chronic lung disease (CLD)"
      },
      {
        "name": {
          "en": "2"
        },
        "value": "Congenital syphilis"
      },
      {
        "name": {
          "en": "3"
        },
        "value": "Intraventricular hemorrhage (bleeding in the brain) or periventricular leukomalacia (changes in the brain on an ultrasound or MRI study)"
      },
      {
        "name": {
          "en": "4"
        },
        "value": "Dilation of ventricles (swelling of ventricles of the brain)"
      },
      {
        "name": {
          "en": "5"
        },
        "value": "Meconium aspiration"
      },
      {
        "name": {
          "en": "6"
        },
        "value": "Hypoxic-ischemic encephalopathy (HIE) or neonatal asphyxia"
      },
      {
        "name": {
          "en": "7"
        },
        "value": "Necrotizing enterocolitis (NEC) that required a surgery"
      },
      {
        "name": {
          "en": "8"
        },
        "value": "Neonatal Infection (sepsis, pneumonia, other)"
      },
      {
        "name": {
          "en": "9"
        },
        "value": "Respiratory Distress or Transient tachypnea of the newborn (TTN)"
      },
      {
        "name": {
          "en": "10"
        },
        "value": "Retinopathy of prematurity that required the eye doctors to treat the eye/eyes with laser surgery and/or injections"
      },
      {
        "name": {
          "en": "11"
        },
        "value": "A stroke"
      },
      {
        "name": {
          "en": "12"
        },
        "value": "Pulmonary hypertension (high blood pressure in the lungs)"
      },
      {
        "name": {
          "en": "13"
        },
        "value": "None of the above"
      },
      {
        "name": {
          "en": "999"
        },
        "value": "Don't know"
      },
      {
        "name": {
          "en": "777"
        },
        "value": "Decline to answer"
      }
    ]
  },
