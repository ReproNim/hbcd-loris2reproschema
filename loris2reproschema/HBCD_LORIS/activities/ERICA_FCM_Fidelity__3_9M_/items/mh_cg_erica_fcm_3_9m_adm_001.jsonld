{
  "@context": "https://raw.githubusercontent.com/ReproNim/reproschema/1.0.0/contexts/generic",
  "category": "reproschema:Item",
  "id": "mh_cg_erica_fcm_3_9m_adm_001",
  "prefLabel": {
    "en": "mh_cg_erica_fcm_3_9m_adm_001"
  },
  "question": {
    "en": "1. Examiner follows correct set-up for the protocol: (1) materials are correctly set-up and positioned according to approved site-specific room layout and protocol (e.g., 3-9M etc., materials include highchair, changing pad, floor pad, as well as toys and supplies for the activities), (2) caregiver instructions are readily visible on wall, and (3) bins are labeled correctly, filled with correct materials and set out in reach of caregiver but not child. Score as '1' if all '3' criteria are met; score as '0' if one or more is missed."
  },
  "ui": {
    "inputType": "select"
  },
  "responseOptions": {
    "valueType": [
      "xsd:string"
    ],
    "choices": [
      {
        "name": {
          "en": "yes"
        },
        "value": "Yes"
      },
      {
        "name": {
          "en": "no"
        },
        "value": "No"
      }
    ]
  },
