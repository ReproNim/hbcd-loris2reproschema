  "id": "ph_cg_screenq_017",
  "prefLabel": {
    "en": "ph_cg_screenq_017"
  },
  "question": {
    "en": "When the child is finished watching a TV show/movie or playing an app or video game, how often do you talk about what it was about or why they liked it?"
  },
  "ui": {
    "inputType": "select"
  },
  "responseOptions": {
    "valueType": [
      "xsd:string"
    ],
    "choices": [
      {
        "name": {
          "en": "1"
        },
        "value": "Often"
      },
      {
        "name": {
          "en": "2"
        },
        "value": "Sometimes"
      },
      {
        "name": {
          "en": "3"
        },
        "value": "Rarely"
      },
      {
        "name": {
          "en": "4"
        },
        "value": "Never"
      },
      {
        "name": {
          "en": "999"
        },
        "value": "Don't know"
      },
      {
        "name": {
          "en": "777"
        },
        "value": "Decline to answer"
      }
    ]
